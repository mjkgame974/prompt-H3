# Gemini API key — utilisée par le service src/services/gemini.ts
# Crée ta clé sur https://aistudio.google.com/apikey
# ⚠️ Avec Vite, toute variable VITE_* finit dans le bundle JS final :
#    RESTREINS ta clé par domaine HTTP (autorise uniquement h3.mediateazer.net).
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL où cette app est hébergée (utilisée pour les liens self-ref).
APP_URL="MY_APP_URL"
